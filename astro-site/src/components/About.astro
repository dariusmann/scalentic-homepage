---
import { about as aboutCopy, resolveLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const a = aboutCopy[locale];
const imageSrc = `${import.meta.env.BASE_URL}images/darius.jpg`;
---

<section id="about" class="surface-warm">
  <div class="shell inner">
    <span class="eyebrow">{a.eyebrow}</span>
    <div class="grid">
      <figure class="photo">
        <img src={imageSrc} alt={a.photoAlt} />
        <figcaption>{a.caption}</figcaption>
      </figure>
      <div class="copy">
        <h2>{a.headline}</h2>
        {a.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  section {
    border-bottom: 1px solid var(--surface-warm-line);
  }
  .inner {
    padding-top: 108px;
    padding-bottom: 108px;
  }
  .grid {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: 72px;
    align-items: start;
    margin-top: 48px;
  }
  .photo {
    margin: 0;
  }
  .photo img {
    display: block;
    width: 100%;
    border-radius: 16px;
    border: 1px solid var(--line-strong);
  }
  figcaption {
    font-family: var(--serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted-3);
    margin-top: 14px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(32px, 3.8vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text-bright);
    margin-bottom: 28px;
  }
  .copy p {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .copy p + p {
    margin-top: 20px;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
