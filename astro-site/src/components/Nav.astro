---
import { SITE, BOOKING_URL } from '../consts';
import {
  homeUrl,
  localizedUrl,
  resolveLocale,
  sectionUrl,
  switchLocaleUrl,
  ui,
  type Locale,
} from '../i18n';
import { CASE_STUDY_PATH } from '../content/case-studies/medizinfuchs';

interface Props {
  locale?: Locale;
  /** Mark case study nav item as current */
  current?: 'home' | 'case-study';
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = ui[locale];
const current = Astro.props.current ?? 'home';

const home = homeUrl(locale);
const caseStudyHref = localizedUrl(locale, CASE_STUDY_PATH);
const links = [
  { href: sectionUrl(locale, 'automate'), label: copy.nav.automate },
  { href: sectionUrl(locale, 'how'), label: copy.nav.how },
  { href: sectionUrl(locale, 'about'), label: copy.nav.about },
  { href: sectionUrl(locale, 'faq'), label: copy.nav.faq },
  { href: caseStudyHref, label: copy.nav.caseStudy, current: current === 'case-study' },
];

const deHref = switchLocaleUrl(Astro.url.pathname, locale, 'de');
const enHref = switchLocaleUrl(Astro.url.pathname, locale, 'en');
---

<nav>
  <div class="shell bar">
    <a class="wordmark" href={home}>{SITE.wordmark}</a>
    <div class="links">
      {
        links.map((l) => (
          <a
            class:list={['navlink', { current: l.current }]}
            href={l.href}
            aria-current={l.current ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="actions">
      <div class="lang" role="group" aria-label={copy.lang.aria}>
        <a class:list={['lang-btn', { active: locale === 'de' }]} href={deHref} lang="de" hreflang="de">
          {copy.lang.de}
        </a>
        <a class:list={['lang-btn', { active: locale === 'en' }]} href={enHref} lang="en" hreflang="en">
          {copy.lang.en}
        </a>
      </div>
      <a class="btn btn-primary book" href={BOOKING_URL} target="_blank" rel="noopener">{copy.bookCall}</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 13, 14, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    padding-top: 18px;
    padding-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    flex-shrink: 0;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    white-space: nowrap;
  }
  .navlink.current {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: rgba(190, 255, 245, 0.03);
  }
  .lang-btn {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 6px 9px;
    border-radius: 6px;
    color: var(--muted-2);
  }
  .lang-btn:hover {
    color: var(--text);
  }
  .lang-btn.active {
    color: var(--accent);
    background: var(--accent-wash);
  }
  .book {
    font-size: 15px;
    padding: 9px 18px;
    border-radius: 9px;
  }
  @media (max-width: 980px) {
    .links {
      display: none;
    }
  }
</style>
