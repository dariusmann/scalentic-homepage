---
import type { MedizinfuchsContent } from '../../content/case-studies/medizinfuchs';

interface Props {
  output: MedizinfuchsContent['output'];
}

const { output } = Astro.props;
---

<section class="output" aria-labelledby="output-heading">
  <div class="shell inner">
    <span class="eyebrow">{output.eyebrow}</span>
    <h2 id="output-heading">{output.headline}</h2>
    <p class="lead">{output.lead}</p>

    <div class="mock" role="region" aria-label="Mockup einer generierten Produktbeschreibung">
      <div class="mock-chrome" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <ol class="sections">
        {
          output.sections.map((s) => (
            <li class:list={[{ empty: !s.hasData, highlight: s.highlight }]}>
              <span class="sec-title">{s.title}</span>
              {!s.hasData && <span class="skip">{output.skippedNote}</span>}
              {s.highlight && s.hasData && (
                <table class="mini">
                  <caption>{output.ingredientsTable.caption}</caption>
                  <thead>
                    <tr>
                      {output.ingredientsTable.headers.map((h) => (
                        <th scope="col">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {output.ingredientsTable.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .output {
    border-bottom: 1px solid var(--line);
  }
  .inner {
    padding-top: 96px;
    padding-bottom: 96px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text-bright);
    max-width: 20ch;
  }
  .lead {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 36rem;
    margin-top: 16px;
    margin-bottom: 40px;
  }
  .mock {
    max-width: 640px;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: var(--bg-alt);
    overflow: hidden;
  }
  .mock-chrome {
    display: flex;
    gap: 6px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .mock-chrome span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--faint);
  }
  .sections {
    list-style: none;
    counter-reset: sec;
  }
  .sections li {
    counter-increment: sec;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 14px;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    align-items: baseline;
  }
  .sections li::before {
    content: counter(sec, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted-3);
  }
  .sec-title {
    font-family: var(--serif);
    font-size: 16px;
    color: var(--text-soft);
  }
  .empty {
    opacity: 0.42;
  }
  .empty .sec-title {
    text-decoration: line-through;
    text-decoration-color: rgba(255, 255, 255, 0.25);
  }
  .skip {
    grid-column: 2;
    font-size: 12px;
    color: var(--muted-3);
  }
  .highlight {
    background: rgba(255, 255, 255, 0.03);
  }
  .mini {
    grid-column: 2;
    width: 100%;
    max-width: 280px;
    margin-top: 8px;
    border-collapse: collapse;
    font-size: 13px;
  }
  .mini caption {
    text-align: left;
    font-size: 12px;
    color: var(--muted-2);
    margin-bottom: 8px;
    caption-side: top;
  }
  .mini th,
  .mini td {
    padding: 6px 10px;
    border: 1px solid var(--line);
    text-align: left;
  }
  .mini th {
    font-weight: 600;
    color: var(--muted-2);
    background: rgba(0, 0, 0, 0.2);
  }
  .mini td {
    color: var(--text-soft);
    font-family: var(--serif);
  }
</style>
