---
import type { MedizinfuchsContent } from '../../content/case-studies/medizinfuchs';

interface Props {
  tech: MedizinfuchsContent['tech'];
}

const { tech } = Astro.props;
---

<section class="tech" aria-labelledby="tech-heading">
  <div class="shell inner">
    <span class="eyebrow">{tech.eyebrow}</span>
    <h2 id="tech-heading">{tech.headline}</h2>
    <ul class="row" aria-label="Technologien">
      {tech.badges.map((b) => <li>{b}</li>)}
    </ul>
    <p class="note">{tech.note}</p>
  </div>
</section>

<style>
  .tech {
    border-bottom: 1px solid var(--line);
  }
  .inner {
    padding-top: 80px;
    padding-bottom: 80px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.2vw, 40px);
    color: var(--text-bright);
    margin-bottom: 28px;
  }
  .row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .row li {
    font-size: 14px;
    font-weight: 600;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text-soft);
  }
  .note {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--muted-2);
    margin-top: 20px;
  }
</style>
