---
import type { MedizinfuchsContent } from '../../content/case-studies/medizinfuchs';

interface Props {
  challenge: MedizinfuchsContent['challenge'];
}

const { challenge } = Astro.props;
---

<section class="challenge" aria-labelledby="challenge-heading">
  <div class="shell inner">
    <span class="eyebrow">{challenge.eyebrow}</span>
    <h2 id="challenge-heading">{challenge.headline}</h2>
    <p class="lead">{challenge.lead}</p>

    <div class="compare" role="group" aria-label="Vorher und Nachher">
      <div class="pane before">
        <h3>{challenge.before.title}</h3>
        <ol>
          {challenge.before.items.map((item) => <li>{item}</li>)}
        </ol>
      </div>
      <div class="arrow" aria-hidden="true">
        <svg width="40" height="24" viewBox="0 0 40 24" fill="none">
          <path d="M2 12h32M26 4l10 8-10 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <div class="pane after">
        <h3>{challenge.after.title}</h3>
        <ol>
          {challenge.after.items.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .challenge {
    border-bottom: 1px solid var(--line);
  }
  .inner {
    padding-top: 96px;
    padding-bottom: 96px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text-bright);
    max-width: 18ch;
  }
  .lead {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 36rem;
    margin-top: 16px;
    margin-bottom: 48px;
  }
  .compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: stretch;
  }
  .pane {
    padding: 28px 28px 32px;
    border-radius: 14px;
    border: 1px solid var(--line);
  }
  .before {
    background: var(--sunken);
    border-style: dashed;
  }
  .after {
    background: var(--bg-alt);
    border-color: var(--line-strong);
  }
  .pane h3 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 20px;
  }
  .pane ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pane li {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--text-soft);
    padding-left: 22px;
    position: relative;
  }
  .pane li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--faint);
  }
  .after li::before {
    background: var(--text-soft);
  }
  .arrow {
    display: flex;
    align-items: center;
    color: var(--muted-3);
  }
  @media (max-width: 760px) {
    .inner {
      padding-top: 72px;
      padding-bottom: 72px;
    }
    .compare {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .arrow {
      justify-content: center;
      transform: rotate(90deg);
      padding: 4px 0;
    }
  }
</style>
