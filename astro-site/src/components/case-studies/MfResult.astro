---
import type { MedizinfuchsContent } from '../../content/case-studies/medizinfuchs';

interface Props {
  result: MedizinfuchsContent['result'];
}

const { result } = Astro.props;
---

<section class="result" aria-labelledby="result-heading">
  <div class="shell inner">
    <span class="eyebrow">{result.eyebrow}</span>
    <h2 id="result-heading">{result.headline}</h2>
    <p class="body">{result.body}</p>

    <div class="metrics">
      <div class="kpi">
        <p class="kpi-value">{result.kpi.value}</p>
        <p class="kpi-label">{result.kpi.label}</p>
      </div>
      <dl class="stats">
        {
          result.stats.map((stat) => (
            <div>
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="unchanged">
      <h3>{result.unchanged.title}</h3>
      <ul>
        {result.unchanged.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .result {
    border-bottom: 1px solid var(--line);
    background: var(--bg-alt);
  }
  .inner {
    padding-top: 96px;
    padding-bottom: 96px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.018em;
    color: var(--text-bright);
    max-width: 20ch;
  }
  .body {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 38rem;
    margin-top: 16px;
  }
  .metrics {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 20px;
    align-items: stretch;
    margin-top: 48px;
  }
  .kpi {
    padding: 32px;
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--accent-line);
    border-radius: 16px;
    background: var(--bg);
  }
  .kpi-value {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(44px, 5.4vw, 64px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text-bright);
  }
  .kpi-label {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--muted);
    margin-top: 12px;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .stats > div {
    padding: 32px 26px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg);
  }
  .stats dt {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-bright);
  }
  .stats dd {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    margin-top: 12px;
  }
  .unchanged {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .unchanged h3 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 22px;
  }
  .unchanged ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .unchanged li {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--text-soft);
    padding-left: 26px;
    position: relative;
  }
  .unchanged li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.42em;
    width: 11px;
    height: 6px;
    border-left: 1.8px solid var(--accent);
    border-bottom: 1.8px solid var(--accent);
    transform: rotate(-45deg);
  }
  @media (max-width: 900px) {
    .metrics {
      grid-template-columns: 1fr;
    }
    .unchanged ul {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
