---
import type { MedizinfuchsContent } from '../../content/case-studies/medizinfuchs';

interface Props {
  glance: MedizinfuchsContent['glance'];
}

const { glance } = Astro.props;
---

<section class="glance" aria-labelledby="glance-heading">
  <div class="shell inner">
    <h2 class="eyebrow" id="glance-heading">{glance.eyebrow}</h2>

    <dl class="items">
      {
        glance.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="meta">
      <dl class="facts">
        {
          glance.meta.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>{glance.stackLabel}</dt>
          <dd>
            <ul class="chips">
              {glance.stack.map((tech) => <li>{tech}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
      <p class="note">{glance.stackNote}</p>
    </div>
  </div>
</section>

<style>
  .glance {
    border-bottom: 1px solid var(--line);
    background: var(--bg-alt);
  }
  .inner {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .eyebrow {
    margin-bottom: 26px;
  }
  .items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .items > div {
    padding-top: 16px;
    border-top: 1px solid var(--accent-line);
  }
  .items dt,
  .facts dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-3);
    margin-bottom: 10px;
  }
  .items dd {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-soft);
  }
  .meta {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    align-items: start;
  }
  .facts dd {
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    padding: 6px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    color: var(--text-soft);
    background: var(--bg);
  }
  .note {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--muted-2);
    margin-top: 20px;
  }
  @media (max-width: 900px) {
    .items {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .facts {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
  @media (max-width: 560px) {
    .items {
      grid-template-columns: 1fr;
    }
  }
</style>
