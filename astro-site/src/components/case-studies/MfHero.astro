---
import type { MedizinfuchsContent } from '../../content/case-studies/medizinfuchs';

interface Props {
  hero: MedizinfuchsContent['hero'];
}

const { hero } = Astro.props;
---

<header class="cs-hero">
  <div class="shell grid">
    <div class="copy">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title}</h1>
      <p class="summary">{hero.summary}</p>
      <dl class="meta">
        <div>
          <dt>{hero.clientLabel}</dt>
          <dd>
            <a class="client-logo" href={hero.clientUrl} target="_blank" rel="noopener">
              <img
                src={hero.logo.src}
                alt={hero.logo.alt}
                width={hero.logo.width}
                height={hero.logo.height}
              />
            </a>
            <span class="client-name">{hero.client}</span>
            <span class="note">{hero.clientNote}</span>
          </dd>
        </div>
      </dl>
    </div>
    <aside class="kpi" aria-label="Kennzahl">
      <p class="kpi-value">{hero.kpi.value}</p>
      <p class="kpi-label">{hero.kpi.label}</p>
    </aside>
  </div>
</header>

<style>
  .cs-hero {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 80% 60% at 90% 10%, var(--accent-wash), transparent 55%),
      var(--bg);
  }
  .grid {
    padding-top: 96px;
    padding-bottom: 88px;
    display: grid;
    grid-template-columns: 1.4fr 0.7fr;
    gap: 48px;
    align-items: end;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.018em;
    color: var(--text-bright);
    max-width: 16ch;
  }
  .summary {
    font-family: var(--serif);
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.6;
    color: var(--text-soft);
    max-width: 38rem;
    margin-top: 22px;
  }
  .meta {
    display: block;
    margin-top: 40px;
    max-width: 320px;
  }
  .meta dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-3);
    margin-bottom: 8px;
  }
  .meta dd {
    font-family: var(--serif);
    font-size: 17px;
    color: var(--text);
    line-height: 1.45;
  }
  .client-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 12px;
    transition: opacity 0.18s ease;
  }
  .client-logo:hover {
    opacity: 0.9;
  }
  .client-logo img {
    display: block;
    width: auto;
    height: 40px;
  }
  .client-name {
    display: block;
  }
  .meta .note {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
  .kpi {
    border: 1px solid var(--surface-warm-line);
    border-left: 3px solid var(--accent-line);
    border-radius: 16px;
    background: var(--surface-warm);
    padding: 36px 32px;
  }
  .kpi-value {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(48px, 6vw, 72px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text-bright);
  }
  .kpi-label {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.45;
    color: var(--muted);
    margin-top: 14px;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      padding-top: 64px;
      padding-bottom: 56px;
      gap: 32px;
      align-items: start;
    }
    .meta {
      max-width: none;
    }
    h1 {
      max-width: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-logo {
      transition: none;
    }
  }
</style>
