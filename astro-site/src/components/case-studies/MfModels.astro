---
import type { MedizinfuchsContent } from '../../content/case-studies/medizinfuchs';

interface Props {
  models: MedizinfuchsContent['models'];
}

const { models } = Astro.props;
---

<section class="models" aria-labelledby="models-heading">
  <div class="shell inner">
    <span class="eyebrow">{models.eyebrow}</span>
    <h2 id="models-heading">{models.headline}</h2>
    <p class="lead">{models.lead}</p>

    <ol class="points">
      {
        models.points.map((p, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .models {
    border-bottom: 1px solid var(--line);
    background: var(--bg-alt);
  }
  .inner {
    padding-top: 96px;
    padding-bottom: 96px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text-bright);
    max-width: 22ch;
  }
  .lead {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 38rem;
    margin-top: 16px;
    margin-bottom: 40px;
  }
  .points {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .points li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--accent-line);
  }
  .n {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--accent);
  }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 20px;
    color: var(--text-bright);
    margin-bottom: 10px;
  }
  .points p {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .points {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
