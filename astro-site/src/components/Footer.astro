---
import { SITE, BOOKING_URL, EMAIL } from '../consts';
import {
  localizedUrl,
  resolveLocale,
  sectionUrl,
  ui,
  type Locale,
} from '../i18n';
import { CASE_STUDY_PATH } from '../content/case-studies/medizinfuchs';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = ui[locale];
const year = new Date().getFullYear();
---

<footer>
  <div class="shell top">
    <div>
      <span class="wordmark">{SITE.wordmark}</span>
      <p class="blurb">{copy.footer.blurb}</p>
    </div>
    <div class="col">
      <span class="col-title">{copy.footer.company}</span>
      <a class="navlink" href={sectionUrl(locale, 'about')}>{copy.footer.about}</a>
      <a class="navlink" href={localizedUrl(locale, CASE_STUDY_PATH)}>{copy.footer.caseStudy}</a>
    </div>
    <div class="col">
      <span class="col-title">{copy.footer.automate}</span>
      <a class="navlink" href={sectionUrl(locale, 'automate')}>{copy.footer.operations}</a>
      <a class="navlink" href={sectionUrl(locale, 'automate')}>{copy.footer.sales}</a>
      <a class="navlink" href={sectionUrl(locale, 'automate')}>{copy.footer.marketing}</a>
    </div>
    <div class="col">
      <span class="col-title">{copy.footer.contact}</span>
      <a class="navlink" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a class="navlink" href={BOOKING_URL} target="_blank" rel="noopener">{copy.bookCall}</a>
    </div>
  </div>
  <div class="shell bottom">
    <span>© {year} Scalentic. {copy.footer.rights}</span>
    <span>{copy.footer.built}</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
  }
  .top {
    padding: 64px 40px 40px;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
    display: block;
    margin-bottom: 18px;
  }
  .blurb {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted-2);
    max-width: 280px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 11px;
    font-size: 15px;
  }
  .col-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted-3);
    text-transform: uppercase;
    margin-bottom: 5px;
  }
  .bottom {
    padding: 24px 40px 48px;
    border-top: 1px solid rgba(var(--fg-rgb), 0.07);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13.5px;
    color: var(--muted-3);
  }
  @media (max-width: 760px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
