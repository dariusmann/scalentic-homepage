---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Automate from '../../components/Automate.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import About from '../../components/About.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Footer from '../../components/Footer.astro';
import { getHome, localizedUrl, ui, type Locale } from '../../i18n';

const locale: Locale = 'en';
const campaign = getHome(locale);
const copy = ui[locale];
const title = campaign.meta.title ?? copy.meta.homeTitle;
---

<Layout
  title={title}
  description={campaign.meta.description}
  lang={locale}
  canonicalPath="/en/"
  alternateDe="/"
  alternateEn={localizedUrl('en')}
>
  <Nav locale={locale} />
  <Hero
    hero={campaign.hero}
    bookLabel={copy.bookCall}
    secondaryLabel={copy.seeAutomate}
    secondaryHref="#automate"
  />
  <Automate automate={campaign.automate} eyebrow={copy.eyebrows.automate} />
  <HowItWorks howItWorks={campaign.howItWorks} eyebrow={copy.eyebrows.how} />
  <About locale={locale} />
  <Faq faq={campaign.faq} eyebrow={copy.eyebrows.faq} headline={copy.faqHeadline} />
  <FinalCta finalCta={campaign.finalCta} bookLabel={copy.bookCall} />
  <Footer locale={locale} />
</Layout>
