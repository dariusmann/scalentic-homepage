---
import { CASE_STUDY_PATH, getMedizinfuchs } from '../../../content/case-studies/medizinfuchs';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import MfHero from '../../../components/case-studies/MfHero.astro';
import MfChallenge from '../../../components/case-studies/MfChallenge.astro';
import MfPipeline from '../../../components/case-studies/MfPipeline.astro';
import MfSources from '../../../components/case-studies/MfSources.astro';
import MfGuardrails from '../../../components/case-studies/MfGuardrails.astro';
import MfOutput from '../../../components/case-studies/MfOutput.astro';
import MfTech from '../../../components/case-studies/MfTech.astro';
import MfResult from '../../../components/case-studies/MfResult.astro';
import { localizedUrl, type Locale } from '../../../i18n';

const locale: Locale = 'en';
const cs = getMedizinfuchs(locale);
---

<Layout
  title={cs.meta.title}
  description={cs.meta.description}
  lang={locale}
  canonicalPath={`/en/${CASE_STUDY_PATH}`}
  ogTitle={cs.meta.ogTitle}
  ogDescription={cs.meta.ogDescription}
  alternateDe={localizedUrl('de', CASE_STUDY_PATH)}
  alternateEn={localizedUrl('en', CASE_STUDY_PATH)}
>
  <Nav locale={locale} current="case-study" />
  <main>
    <MfHero hero={cs.hero} />
    <MfChallenge challenge={cs.challenge} />
    <MfPipeline pipeline={cs.pipeline} />
    <MfSources sources={cs.sources} />
    <MfGuardrails guardrails={cs.guardrails} />
    <MfOutput output={cs.output} />
    <MfTech tech={cs.tech} />
    <MfResult result={cs.result} />
  </main>
  <Footer locale={locale} />
</Layout>
