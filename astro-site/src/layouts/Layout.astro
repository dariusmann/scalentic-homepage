---
import '../styles/global.css';
import { defaultLocale, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  alternateDe?: string;
  alternateEn?: string;
}

const {
  title,
  description,
  lang = defaultLocale,
  canonicalPath,
  ogTitle,
  ogDescription,
  alternateDe,
  alternateEn,
} = Astro.props;

const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://scalentic.com';
const path = canonicalPath ?? Astro.url.pathname;
const canonical = `${site}${path.startsWith('/') ? path : `/${path}`}`;
const ogT = ogTitle ?? title;
const ogD = ogDescription ?? description;
const deUrl = alternateDe ? `${site}${alternateDe.startsWith('/') ? alternateDe : `/${alternateDe}`}` : undefined;
const enUrl = alternateEn ? `${site}${alternateEn.startsWith('/') ? alternateEn : `/${alternateEn}`}` : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {deUrl && <link rel="alternate" hreflang="de" href={deUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {deUrl && <link rel="alternate" hreflang="x-default" href={deUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scalentic" />
    <meta property="og:title" content={ogT} />
    <meta property="og:description" content={ogD} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    {lang === 'de' && enUrl && <meta property="og:locale:alternate" content="en_US" />}
    {lang === 'en' && deUrl && <meta property="og:locale:alternate" content="de_DE" />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogT} />
    <meta name="twitter:description" content={ogD} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}assets/favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}assets/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Literata:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
